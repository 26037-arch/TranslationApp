<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TranslationApp</AssemblyName>
    <RootNamespace>TranslationApp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Runtime\nllb_worker.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Runtime\requirements.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\setup-runtime.ps1" Link="setup-runtime.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
