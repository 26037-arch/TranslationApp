<Window x:Class="TranslationApp.Views.OcrSelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="#55000000" Cursor="Cross" AllowsTransparency="True"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
    <Canvas x:Name="Surface">
        <Border x:Name="SelectionBox" Visibility="Collapsed" BorderBrush="#60A5FA" BorderThickness="2" Background="#22FFFFFF" />
        <Border Canvas.Left="18" Canvas.Top="18" Background="#CC0F172A" CornerRadius="6" Padding="12,8">
            <TextBlock Foreground="White" Text="번역할 영역을 드래그하세요  ·  ESC 취소" FontSize="13" />
        </Border>
    </Canvas>
</Window>
