<Window x:Class="TranslationApp.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Card" Background="#EAF1F8" CornerRadius="8" Padding="16,11" BorderBrush="#334155" BorderThickness="1">
        <TextBlock x:Name="MessageText" Foreground="White" FontSize="13" MaxWidth="420" TextWrapping="Wrap" />
    </Border>
</Window>
